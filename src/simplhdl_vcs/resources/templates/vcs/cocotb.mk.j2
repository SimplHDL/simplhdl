export PYTHONPYCACHEPREFIX = ./pycache
ifndef PYTHONPATH
  export PYTHONPATH := {{pythonpath}}
else
  export PYTHONPATH := {{pythonpath}}:$(PYTHONPATH)
endif
export LIBPYTHON_LOC := {{get_libpython()}}

VCS_FLAGS += +warn=noVPI-CT-NS +vpi -P pli.tab -load {{get_lib_name_path("vpi", "vcs")}}
VCS_FLAGS += -debug_access+r+w+nomemcbk -debug_region+cell+encrypt -debug_acc+pp+f+dmptf

export PYGPI_PYTHON_BIN := {{get_pythonbin()}}
export COCOTB_TEST_MODULES := {{cocotbtop}}
export COCOTB_TOPLEVEL := {{cocotbdut}}
export MODULE := {{cocotbtop}}
export TOPLEVEL := {{cocotbdut}}
export GPI_USERS := {{get_gpi_users()}}
